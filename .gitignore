# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 템플릿은 예외로 커밋 (실제 값 없음)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — 프로젝트 에이전트만 공유하고 로컬 설정은 제외
.claude/*
!.claude/agents/
!.claude/agents/*.md

# 마스터 테이블 원본 CSV 덤프(중간 재료) — 변환본은 src/lib/data/*-master.json에 커밋됨
/data/
