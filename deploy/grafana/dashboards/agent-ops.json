{
  "uid": "bidmate-agent-ops",
  "title": "BidMate 챗봇 — 운영",
  "description": "챗봇 에이전트 운영 개요. 데이터 소스는 전부 Bidmate/Agent 커스텀 메트릭(로그 메트릭 필터 — monitoring/metric_filters_spec.md)이라 조회 비용이 없다. L2(로그 그룹 /bidmate/agent 수집)·L3(필터 생성) 완료 전까지는 빈 화면이 정상이다.",
  "tags": ["bidmate", "agent"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": { "refresh_intervals": ["1m", "5m", "15m", "1h"] },
  "panels": [
    {
      "type": "stat",
      "title": "대화 수 (기간 합)",
      "description": "turn_end 이벤트 합계 = 정상 종료한 턴 수. 서비스 요청 수(L2 미들웨어)와의 차이가 곧 크래시 건수다.",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "region": "default",
          "metricQueryType": 1,
          "metricEditorMode": 1,
          "expression": "SUM(SEARCH('{Bidmate/Agent,route} MetricName=\"TurnCount\"', 'Sum', 300))",
          "label": "대화",
          "period": ""
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "턴 지연 p95 (route별, 최근)",
      "description": "route마다 정상 범위가 다르다 — 기타는 ~1.5s(라우터만), 검색·자격은 수 초대. 전 route가 함께 오르면 공용 구간(LLM·DB) 문제.",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "Bidmate/Agent",
          "metricName": "TurnLatencyMs",
          "statistic": "p95",
          "dimensions": { "route": ["*"] },
          "label": "",
          "matchExact": false,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": ""
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10000 }, { "color": "red", "value": 15000 }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "LLM 재시도 (기간 합)",
      "description": "0이 정상. 늘면 Bedrock 스로틀·장애 신호 — D3(LLM 대시보드)의 스로틀 패널과 대조.",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
