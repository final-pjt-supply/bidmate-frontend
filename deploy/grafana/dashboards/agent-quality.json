  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": { "refresh_intervals": ["1m", "5m", "15m", "1h"] },
  "panels": [
