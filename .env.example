# 실제 값은 .env / .env.local 에 넣으세요 (git에 커밋되지 않음).
# 이 파일은 "어떤 키가 필요한지"만 알려주는 템플릿입니다.

# ── 런타임(서버사이드 전용) ──────────────────────────────
# 백엔드 API 주소. 브라우저가 아니라 Next 서버가 호출하므로 외부에 노출되지 않는다.
#   로컬 개발      : http://54.180.233.72:8000
#   배포(같은 VPC) : http://<백엔드-프라이빗-IP>:8000
#   베스천 터널 시 : http://localhost:8000
API_BASE_URL=http://54.180.233.72:8000

# ── 빌드타임(NEXT_PUBLIC_*: 브라우저 번들에 포함됨) ──────
# Sentry DSN은 코드에 기본값이 있어 비워둬도 동작. 교체하려면 지정.
# NEXT_PUBLIC_SENTRY_DSN=

# 로컬 개발 중 Sentry 전송을 끄고 싶을 때
# NEXT_PUBLIC_SENTRY_ENABLED=false

# ── 미완성 기능 스위치 (#140) ───────────────────────────
# 값이 없으면 꺼진다. "true"라고 적을 때만 켜진다 — 배포에 깜빡 안 넣어도
# 미완성 기능이 사용자에게 노출되지 않는다.
#
# 로컬 개발에서는 켜서 쓰세요(.env.local 에 아래 두 줄 복사).
# 배포(deploy.yml)에는 넣지 않습니다. 켤 때가 되면 Dockerfile 의 ARG/ENV 와
# deploy.yml 의 build-args 에도 함께 추가해야 합니다(NEXT_PUBLIC_* 는 빌드
# 시점에 번들로 박히므로 런타임 주입으로는 들어가지 않습니다).

# 비드봇(챗봇). 백엔드 에이전트 미완성.
# NEXT_PUBLIC_BIDBOT_ENABLED=true

# 맞춤추천에서 "확인필요"·"보완가능" 판정까지 표시할지. 판정 로직 개선 후 켠다.
# NEXT_PUBLIC_SHOW_ALL_VERDICTS=true

# ── 배포 전용(선택) ─────────────────────────────────────
# 소스맵 업로드용. 있으면 빌드 시 Sentry에 원본 소스 라인 업로드.
# SENTRY_AUTH_TOKEN=
