# 실제 값은 .env / .env.local 에 넣으세요 (git에 커밋되지 않음).
# 이 파일은 "어떤 키가 필요한지"만 알려주는 템플릿입니다.

# ── 런타임(서버사이드 전용) ──────────────────────────────
# 백엔드 API 주소. 브라우저가 아니라 Next 서버가 호출하므로 외부에 노출되지 않는다.
#   로컬 개발      : http://54.180.233.72:8000
#   배포(같은 VPC) : http://<백엔드-프라이빗-IP>:8000
#   베스천 터널 시 : http://localhost:8000
API_BASE_URL=http://54.180.233.72:8000

# ── 빌드타임(NEXT_PUBLIC_*: 브라우저 번들에 포함됨) ──────
# Sentry DSN은 코드에 기본값이 있어 비워둬도 동작. 교체하려면 지정.
# NEXT_PUBLIC_SENTRY_DSN=

# 로컬 개발 중 Sentry 전송을 끄고 싶을 때
# NEXT_PUBLIC_SENTRY_ENABLED=false

# ── 배포 전용(선택) ─────────────────────────────────────
# 소스맵 업로드용. 있으면 빌드 시 Sentry에 원본 소스 라인 업로드.
# SENTRY_AUTH_TOKEN=
